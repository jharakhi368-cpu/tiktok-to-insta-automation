# REQUIRED — the only variable a fresh install needs.
# Postgres connection string, e.g. from Neon / Supabase / Railway Postgres:
DATABASE_URL=postgresql://user:password@host:5432/reelay

# OPTIONAL — everything below can be linked from the web UI instead
# (Console → Telegram page, Console → Instagram page). Values in the
# database always take precedence over these.

# Public origin of this install. Auto-detected from the browser if unset.
# PUBLIC_BASE_URL=https://your-app.up.railway.app

# Telegram bot (from @BotFather)
# TELEGRAM_BOT_TOKEN=123456789:AA...
# TELEGRAM_BOT_HANDLE=@your_bot

# Instagram via Zernio (recommended — no Meta app needed)
# ZERNIO_API_KEY=sk_...
# ZERNIO_ACCOUNT_ID=...

# Instagram via Meta Graph API (advanced)
# IG_ACCESS_TOKEN=
# IG_BUSINESS_ACCOUNT_ID=

# Scheduler tick interval in milliseconds (default 15000)
# SCHEDULER_INTERVAL_MS=15000

# OPTIONAL — email delivery for sign-in codes (Resend)
# Without this, sign-in fails with a clear error instead of exposing the code.
# Get a key at resend.com/api-keys — free tier, no card.
# RESEND_API_KEY=re_...
# Sender. Must be a verified sender in Resend; onboarding@resend.dev only
# delivers to the address that owns the Resend account.
# EMAIL_FROM="REELAY <codes@yourdomain.com>"
